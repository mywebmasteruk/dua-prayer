# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only — never expose in client code or commit to git
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# One-time database setup (scripts/setup-database.mjs) — from Supabase → Settings → Database → URI
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: Cloudflare Turnstile bot protection (https://dash.cloudflare.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App URL (for auth redirects in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Super admin — full access (case-insensitive email match). Preferred env name.
SUPER_ADMIN_EMAIL=webmaster@duaprayer.com

# Legacy aliases (optional; SUPER_ADMIN_EMAIL takes precedence)
# PLATFORM_FOUNDER_EMAIL=webmaster@duaprayer.com
# SETUP_ADMIN_EMAIL=webmaster@duaprayer.com

# Stripe donations — masjidweb.com account (https://dashboard.stripe.com/acct_1NsPzqErjsRv8lCa)
# Required: secret key + app URL. Checkout uses dynamic amounts for any whole-dollar value.
# Server-only — use a restricted key (rk_) in production when possible
STRIPE_SECRET_KEY=sk_live_your_key_here
# Optional publishable key for future client-side Stripe features
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
# Optional — groups donations under one Stripe product in your dashboard
STRIPE_DONATION_PRODUCT_ID=prod_UfiS0mCPr50vv3
# Optional webhook signing secret (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Optional preset one-time price IDs (legacy / dashboard reference)
STRIPE_PRICE_DONATION_5=price_your_one_time_5_usd
STRIPE_PRICE_DONATION_10=price_your_one_time_10_usd
STRIPE_PRICE_DONATION_25=price_your_one_time_25_usd
STRIPE_PRICE_DONATION_50=price_your_one_time_50_usd
STRIPE_PRICE_DONATION_100=price_your_one_time_100_usd

# Optional preset monthly recurring price IDs (dashboard reference; checkout uses dynamic price_data)
STRIPE_PRICE_DONATION_MONTHLY_5=price_your_monthly_5_usd
STRIPE_PRICE_DONATION_MONTHLY_10=price_your_monthly_10_usd
STRIPE_PRICE_DONATION_MONTHLY_25=price_your_monthly_25_usd
STRIPE_PRICE_DONATION_MONTHLY_50=price_your_monthly_50_usd
STRIPE_PRICE_DONATION_MONTHLY_100=price_your_monthly_100_usd
