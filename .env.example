# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only — never expose in client code or commit to git
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# One-time database setup (scripts/setup-database.mjs) — from Supabase → Settings → Database → URI
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: Cloudflare Turnstile bot protection (https://dash.cloudflare.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App URL (for auth redirects in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Volunteer registration webhook (inbound Fillout/Zapier → pending profile)
# Required header on POST /api/webhooks/volunteer: X-Webhook-Secret
VOLUNTEER_WEBHOOK_SECRET=generate_a_long_random_secret_here

# Channel registration webhook (inbound Fillout → pending category application)
# Required header on POST /api/webhooks/channel: X-Webhook-Secret
CHANNEL_WEBHOOK_SECRET=generate_a_long_random_secret_here

# Optional outbound notification when a new volunteer application is created (Slack/Zapier)
# VOLUNTEER_NOTIFY_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your-id/

# Optional outbound notification when a new channel application is created
# CHANNEL_NOTIFY_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your-id/

# Admin access is hard-coded server-side to webmaster@duaprayer.com only.
# This value is informational for old setup scripts/docs and does not grant access.
SUPER_ADMIN_EMAIL=webmaster@duaprayer.com

# Stripe donations — masjidweb.com account (https://dashboard.stripe.com/acct_1NsPzqErjsRv8lCa)
# Required: secret key + app URL. Checkout uses dynamic amounts for any whole-dollar value.
# Server-only — use a restricted key (rk_) in production when possible
STRIPE_SECRET_KEY=sk_live_your_key_here
# Optional publishable key for future client-side Stripe features
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
# Optional — groups donations under one Stripe product in your dashboard
STRIPE_DONATION_PRODUCT_ID=prod_UfiS0mCPr50vv3
# Webhook signing secret for POST /api/webhooks/stripe (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Optional Stripe TEST mode credentials (used when Admin → Settings → Stripe
# mode is "test"; DB-stored values take precedence over these env fallbacks)
# STRIPE_TEST_SECRET_KEY=sk_test_your_key_here
# NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your_key_here
# STRIPE_TEST_WEBHOOK_SECRET=whsec_your_test_secret_here
# STRIPE_TEST_DONATION_PRODUCT_ID=prod_your_test_product

# E2E tests (optional) — real credentials for the password-login spec
# (e2e/auth.spec.ts skips this test when unset)
# E2E_LOGIN_EMAIL=test-account@example.com
# E2E_LOGIN_PASSWORD=your_test_password
